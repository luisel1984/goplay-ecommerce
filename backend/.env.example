NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://goplay:goplay@localhost:5432/goplay
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Dropshipping
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
CJ_API_TOKEN=
CJ_EMAIL=

# Shipping FR
COLISSIMO_CONTRACT_NUMBER=
COLISSIMO_PASSWORD=
MONDIALRELAY_BRAND_ID=BDTEST13
MONDIALRELAY_PRIVATE_KEY=PrivateK

# Email (Resend or SMTP)
RESEND_API_KEY=
EMAIL_FROM=contact@goplayelectronic.fr
